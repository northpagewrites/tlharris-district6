{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "T. L. Harris — District 6",
    "description": "The District 6 officeholder site, built from the Git repository in your browser. No server, nothing to install.",
    "author": "northpagewrites"
  },
  "preferredVersions": {
    "php": "8.2",
    "wp": "7.1.1"
  },
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/northpagewrites/tlharris-district6",
        "ref": "main",
        "refType": "branch"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "tlharris-core/tlharris-core.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "tlharris-public"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "T. L. Harris",
        "blogdescription": "Commissioner · District 6",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php define( 'TLHARRIS_PLAYGROUND_PREVIEW', true ); require '/wordpress/preview/bootstrap.php';"
    }
  ]
}
